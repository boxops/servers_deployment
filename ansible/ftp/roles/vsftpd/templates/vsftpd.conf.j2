# Example vsftpd configuration generated by Ansible role
# See: https://documentation.ubuntu.com/server/how-to/networking/ftp/

listen={{ 'YES' if vsftpd_listen else 'NO' }}
listen_ipv6={{ 'YES' if vsftpd_listen_ipv6 else 'NO' }}

anonymous_enable=NO
local_enable={{ 'YES' if vsftpd_local_enable else 'NO' }}
write_enable={{ 'YES' if vsftpd_write_enable else 'NO' }}
local_umask={{ vsftpd_local_umask }}

# Chroot local users for security
chroot_local_user={{ 'YES' if vsftpd_chroot_local_user else 'NO' }}

# Allow passive mode (optional defaults)
pasv_min_port=40000
pasv_max_port=40100

# Logging
xferlog_enable=YES
connect_from_port_20=YES

# Use local users
user_sub_token={{ vsftpd_user_sub_token }}
local_root={{ vsftpd_local_root }}

# Disable PAM login requirement if anonymous only
pam_service_name=vsftpd
